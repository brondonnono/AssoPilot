{
  "name": "asso-pilot",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve": "concurrently \"npm run start\" \"npm run electron:watch\"",
    "electron:watch": "wait-on http://localhost:4200 && electron .",
    "build": "ng build --base-href ./",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:ng-build": "ng build && tsc -p electron/tsconfig.json",
    "test": "ng test",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@angular/cdk": "^20.2.5",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.5",
    "@angular/material-moment-adapter": "^20.2.10",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@ngrx/effects": "^20.0.1",
    "@ngrx/entity": "^20.0.1",
    "@ngrx/store": "^20.0.1",
    "@ngrx/store-devtools": "^20.0.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@tailwindcss/postcss": "^4.1.13",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "file-saver": "^2.0.5",
    "ngrx-store-localstorage": "^20.0.0",
    "postcss": "^8.5.6",
    "remixicon": "^4.6.0",
    "rxjs": "~7.8.0",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^4.1.13",
    "tslib": "^2.3.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.3",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.0",
    "@types/electron": "^1.4.38",
    "@types/uuid": "^10.0.0",
    "angular-eslint": "20.4.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.37.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.assopilot.app",
    "productName": "AssoPilot",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/asso-pilot/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
